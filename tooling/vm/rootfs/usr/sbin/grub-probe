#!/bin/sh
# Wrapper um grub-probe (das Original liegt per dpkg-divert unter grub-probe.real). Das Wurzeldateisystem dieser
# Lern-VM kommt per 9p aus dem Emulator und liegt auf keinem Blockgerät. grub-mkconfig fragt nach dem Gerät von /,
# um root= auf die Kernelzeile zu schreiben; die Antwort ist host9p. Alles andere, etwa die Partition mit /boot,
# beantwortet das echte grub-probe.
target= device= path=
for arg; do
	case $arg in
		--target=*) target=${arg#--target=} ;;
		--device) device=1 ;;
		-*) ;;
		*) path=$arg ;;
	esac
done
if [ -n "$device" ] && [ "$path" = host9p ]; then
	exit 1
fi
if [ -z "$device" ] && [ "$target" = device ] && [ "$(stat -f -c %T "$path" 2>/dev/null)" = v9fs ]; then
	echo host9p
	exit 0
fi
exec /usr/sbin/grub-probe.real "$@"
