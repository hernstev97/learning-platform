#!/bin/bash
# Steuerkanal der Lernplattform. Die Seite schickt über die zweite serielle Schnittstelle (ttyS1) Zeilen der Form
# "<id> <bash-skript als base64>" und bekommt "@@<id> <exit-code> <ausgabe als base64>" zurück. Darüber laufen
# Szenario-Aufbau, Uhrzeit, Terminalgröße und die Prüfung. Die VM hat kein Netzwerk; ttyS1 erreicht nur die Seite.
set -u
port=/dev/ttyS1
stty -F "$port" raw -echo -ixon -ixoff
exec 3<>"$port"
printf '@@ready\n' >&3
while IFS=' ' read -r id payload <&3; do
	[[ $id =~ ^[0-9]+$ ]] || continue
	script=$(mktemp)
	printf '%s' "$payload" | base64 -d > "$script" 2>/dev/null
	# 3>&-: Skripte und alles, was sie starten, erben den Steuerkanal nicht.
	out=$(cd / && timeout 120 bash "$script" 2>&1 </dev/null 3>&-)
	code=$?
	rm -f "$script"
	printf '@@%s %s %s\n' "$id" "$code" "$(printf '%s' "${out:0:65536}" | base64 -w0)" >&3
done
