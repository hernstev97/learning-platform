# /etc/fstab: statische Informationen über die Dateisysteme. Siehe fstab(5).
#
# <Dateisystem>  <Einhängepunkt>  <Typ>  <Optionen>  <dump>  <pass>
#
# Das Wurzeldateisystem kommt in dieser Lern-VM per 9p aus dem Emulator (host9p). Auf einem echten Server steht
# hier eine Partition, zum Beispiel UUID=… / ext4 errors=remount-ro 0 1.
host9p          /        9p     rw,trans=virtio,version=9p2000.L,cache=loose  0  0
# /boot auf der ersten Partition der Platte /dev/sda
LABEL=boot      /boot    ext4   defaults  0  2
