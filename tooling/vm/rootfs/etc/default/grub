# Wird von update-grub gelesen, um /boot/grub/grub.cfg zu erzeugen. Nach jeder Änderung: sudo update-grub
# Alle Optionen: info -f grub -n 'Simple configuration'

GRUB_DEFAULT=0
GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`
# loglevel=3 blendet Startmeldungen des Emulators aus (kein ACPI, knappe MP-Tabelle), die es auf echter Hardware
# nicht gibt. Der Eintrag „recovery mode“ lässt beides weg und zeigt alles.
GRUB_CMDLINE_LINUX_DEFAULT="quiet loglevel=3"
# Die Konsole liegt auf der ersten seriellen Schnittstelle: Das ist das Terminal im Browser.
GRUB_CMDLINE_LINUX="console=ttyS0 mitigations=off init_on_free=on"

# Menü und Eingabe ebenfalls über die serielle Schnittstelle.
GRUB_TERMINAL=serial
GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200"

# Ohne Kommentarzeichen fehlen die Einträge „recovery mode“ im Menü.
#GRUB_DISABLE_RECOVERY="true"
