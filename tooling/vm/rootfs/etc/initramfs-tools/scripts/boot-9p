#!/bin/sh
# BOOT-Skript fürs initramfs (BOOT=boot-9p): mountet das Root-Dateisystem per 9p aus dem Emulator, read-only bei `ro`
# auf der Kernelzeile wie auf jedem Server (systemd-remount-fs macht es danach laut fstab beschreibbar). Die übrigen
# Schritte (mount_top, mount_premount, ...) kommen aus /scripts/local, das init vorher lädt.
mountroot() {
	mount -n -t 9p ${roflag} -o trans=virtio,version=9p2000.L,cache=loose host9p "${rootmnt}"
}
