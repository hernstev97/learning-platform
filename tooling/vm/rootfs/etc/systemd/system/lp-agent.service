[Unit]
Description=Steuerkanal der Lernplattform auf ttyS1 (Szenario-Aufbau und Prüfung)

[Service]
ExecStart=/usr/local/sbin/lp-agent
Environment=HOME=/root
# Skripte sollen sich verhalten wie im Terminal: `seq 9 | head -n 1` endet dort mit SIGPIPE, nicht mit „Broken pipe“.
IgnoreSIGPIPE=no
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
