{
  "name": "learning-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "content:check": "node tooling/content-check.ts",
    "verify": "node tooling/verify-code.ts",
    "bear:build": "python3 content/kotlin/bear/build_course.py",
    "bear:check": "python3 content/kotlin/bear/build_course.py --check",
    "vm:build": "node tooling/vm/build.ts",
    "vm:verify": "node tooling/vm/verify.ts",
    "vm:run": "node tooling/vm/run.ts",
    "pg:run": "node tooling/pg-run.ts",
    "links": "node tooling/check-links.ts",
    "screenshots": "node tooling/screenshots.mjs",
    "lint": "eslint src tooling convex e2e *.config.ts",
    "typecheck": "tsc --noEmit",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "build:production": "convex deploy --cmd \"pnpm build\" --cmd-url-env-var-name VITE_CONVEX_URL",
    "test:convex:e2e": "playwright test --config playwright.convex.config.ts",
    "test:pwa:e2e": "playwright test --config playwright.pwa.config.ts"
  },
  "packageManager": "pnpm@11.23.0",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "convex-test": "0.0.60",
    "eslint": "^10.11.0",
    "marked": "^18.0.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@clerk/clerk-js": "6.34.1",
    "@electric-sql/pglite": "0.5.8",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "convex": "1.46.0",
    "pyodide": "314.0.7",
    "v86": "0.5.462"
  }
}
