# Copy to .env.local. These two VITE_ values are public, embedded at build time.
VITE_CONVEX_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# `pnpm convex:dev` writes CONVEX_DEPLOYMENT to .env.local after selecting your project.
# Set the following ON THE CONVEX DEPLOYMENT, not as VITE_ variables:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev
# ALLOWED_CLERK_USER_ID=user_replace_with_your_immutable_clerk_id

# Production CI only: CONVEX_DEPLOY_KEY, from the intended production deployment.
# Never prefix a secret with VITE_, commit it, or use a production key for preview builds.
